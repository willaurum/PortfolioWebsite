# Example nginx server block for serving the built site on the Raspberry Pi.
#
#   git pull && npm ci && npm run build
#
# then point `root` at the generated dist/ directory. Copy this to
# /etc/nginx/sites-available/willcook.org, symlink it into sites-enabled,
# `sudo nginx -t`, and reload.

server {
    listen 80;
    listen [::]:80;
    server_name willcook.org www.willcook.org;

    root /var/www/willcook.org/dist;
    index index.html;

    # The old site's .htaccess redirected /page.html to /page. Keep those as
    # real 301s so existing links and bookmarks do not rely on the client-side
    # router. (The app also handles these paths itself, so these are optional.)
    location = /index.html                    { return 301 /; }
    location = /projects.html                 { return 301 /projects; }
    location = /learnPython.html              { return 301 /learnPython; }
    location = /theAreanaSim/simulation.html  { return 301 /theAreanaSim/simulation; }

    # Vite emits content-hashed bundles as assets/index-<hash>.js|css, but
    # dist/assets/ also holds the site's own un-hashed files (favicon.svg,
    # the resume PDF, CheckMate.exe, project images), so cache by filename
    # pattern rather than by directory.
    location ~ "^/assets/index-[A-Za-z0-9_-]+\.(js|css)$" {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths are routes, not files, so hand them to
    # index.html and let react-router resolve them.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# HTTPS: run `sudo certbot --nginx -d willcook.org -d www.willcook.org` once the
# block above is live; certbot rewrites it to listen on 443 and adds the
# HTTP-to-HTTPS redirect.
